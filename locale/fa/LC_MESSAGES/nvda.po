msgstr "مرتب‌سازی فهرست بر اساس:"

msgid "Name"
msgstr "نام"

msgid "Memory use"
msgstr "مصرف حافظه"

msgid "CPU"
msgstr "پردازنده"

msgid "PID"
msgstr "شناسه"

msgid "Refresh the list automatically"
msgstr "فهرست خودکار به‌روز شود"

msgid "Every (seconds):"
msgstr "هر چند ثانیه:"

